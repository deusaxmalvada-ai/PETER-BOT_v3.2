'use strict'

const {
  downloadMediaMessage,
  jidNormalizedUser
} = require('@whiskeysockets/baileys')

const fs = require('fs')
const { execSync } = require('child_process')

const BOT_NAME = 'PETER-BOT'
const OWNER_NAME = 'LØRD SUKUNA'

/*
 * IMPORTANTE:
 * Este número deve ser o número que terá permissão de dono.
 * Mantém o mesmo número definido por ti no bot.
 */
const OWNER_NUMBER = '244948179380'
const OWNER_JID = jidNormalizedUser(`${OWNER_NUMBER}@s.whatsapp.net`)

const startTime = Date.now()

const DATA = {
  modo: './modo.json',
  regras: './regras.json',
  warns: './warns.json',
  config: './config.json'
}

const pending = new Map()

let warns = {}
let regras = {
  texto:
    '① 🤝 Respeite os membros.\n' +
    '② 🚫 Evite spam.\n' +
    '③ 🔞 Conteúdo proibido não.\n' +
    '④ 🛡️ Respeite a administração.\n' +
    '⑤ 🕸️ Divirta-se sem arrumar confusão.'
}

let config = {
  welcome: true,
  bye: true,
  welcomeText: '',
  byeText: ''
}

function loadJSON(file, fallback) {
  try {
    if (!fs.existsSync(file)) {
      fs.writeFileSync(file, JSON.stringify(fallback, null, 2))
      return fallback
    }

    return JSON.parse(fs.readFileSync(file, 'utf8'))
  } catch {
    return fallback
  }
}

function saveJSON(file, data) {
  try {
    fs.writeFileSync(file, JSON.stringify(data, null, 2))
  } catch (e) {
    console.log(`Erro ao salvar ${file}:`, e.message)
  }
}

warns = loadJSON(DATA.warns, {})
regras = loadJSON(DATA.regras, regras)
config = loadJSON(DATA.config, config)

function getModo() {
  try {
    const d = JSON.parse(fs.readFileSync(DATA.modo, 'utf8'))
    return d.modo === 'Aranha' ? 'Aranha' : 'Peter'
  } catch {
    return 'Peter'
  }
}

function setModo(modo) {
  const valor = modo === 'Aranha' ? 'Aranha' : 'Peter'
  saveJSON(DATA.modo, { modo: valor })
  return valor
}

function pick(arr) {
  return arr[Math.floor(Math.random() * arr.length)]
}

function isGroup(from) {
  return typeof from === 'string' && from.endsWith('@g.us')
}

function normalizeJid(jid) {
  try {
    return jidNormalizedUser(String(jid || ''))
  } catch {
    return String(jid || '')
  }
}

function isOwner(jid) {
  return normalizeJid(jid) === OWNER_JID
}

function mention(jid) {
  return `@${String(jid || '')
    .split('@')[0]
    .split(':')[0]}`
}

function getSender(m, from) {
  return m?.key?.participant || m?.key?.remoteJid || from
}

function getContextInfo(m) {
  return (
    m?.message?.extendedTextMessage?.contextInfo ||
    m?.message?.imageMessage?.contextInfo ||
    m?.message?.videoMessage?.contextInfo ||
    m?.message?.stickerMessage?.contextInfo ||
    null
  )
}

function getQuotedMessage(m) {
  return getContextInfo(m)?.quotedMessage || null
}

function getQuotedParticipant(m) {
  return getContextInfo(m)?.participant || null
}

function getMentions(m) {
  return getContextInfo(m)?.mentionedJid || []
}

function getFirstMention(m) {
  const list = getMentions(m)
  return list.length ? list[0] : null
}

function formatUptime() {
  let s = Math.floor((Date.now() - startTime) / 1000)

  const d = Math.floor(s / 86400)
  s %= 86400

  const h = Math.floor(s / 3600)
  s %= 3600

  const m = Math.floor(s / 60)
  s %= 60

  if (d) return `${d}d ${h}h ${m}m`
  if (h) return `${h}h ${m}m ${s}s`
  if (m) return `${m}m ${s}s`

  return `${s}s`
}

function getGroupWarns(group) {
  if (!warns[group]) warns[group] = {}
  return warns[group]
}

function getWarn(group, jid) {
  return getGroupWarns(group)[normalizeJid(jid)] || 0
}

function addWarn(group, jid) {
  const j = normalizeJid(jid)
  const data = getGroupWarns(group)

  data[j] = (data[j] || 0) + 1
  saveJSON(DATA.warns, warns)

  return data[j]
}

function resetWarn(group, jid) {
  const j = normalizeJid(jid)
  const data = getGroupWarns(group)

  delete data[j]
  saveJSON(DATA.warns, warns)
}

async function getMetadata(sock, from) {
  if (!isGroup(from)) return null

  try {
    return await sock.groupMetadata(from)
  } catch {
    return null
  }
}

function findParticipant(meta, jid) {
  if (!meta?.participants) return null

  const wanted = normalizeJid(jid)

  return (
    meta.participants.find(
      p => normalizeJid(p.id) === wanted
    ) || null
  )
}

async function isGroupAdmin(sock, from, jid) {
  const meta = await getMetadata(sock, from)
  const participant = findParticipant(meta, jid)

  if (!participant) return false

  return (
    participant.admin === 'admin' ||
    participant.admin === 'superadmin'
  )
}

async function isBotAdmin(sock, from) {
  const botJid = normalizeJid(sock?.user?.id)

  return await isGroupAdmin(sock, from, botJid)
}

async function requireGroup(sock, m, from) {
  if (isGroup(from)) return true

  await sock.sendMessage(
    from,
    {
      text: panelError(
        getModo(),
        'GRUPO',
        'Este comando só funciona em grupos.'
      )
    },
    { quoted: m }
  )

  return false
}

async function requireAdmin(sock, m, from, sender) {
  if (!(await requireGroup(sock, m, from))) return false

  if (isOwner(sender)) return true

  if (!(await isGroupAdmin(sock, from, sender))) {
    await sock.sendMessage(
      from,
      {
        text: panelPermission(
          getModo(),
          'PERMISSÃO',
          'Apenas administradores podem usar esta função.'
        )
      },
      { quoted: m }
    )

    return false
  }

  return true
}

async function requireBotAdmin(sock, m, from) {
  if (!(await isBotAdmin(sock, from))) {
    await sock.sendMessage(
      from,
      {
        text: panelPermission(
          getModo(),
          'BOT',
          'Preciso ser administrador do grupo para executar essa ação.'
        )
      },
      { quoted: m }
    )

    return false
  }

  return true
}

function panelTheme(modo) {
  if (modo === 'Aranha') {
    return {
      footer: '💀',
      icon: '🕷️'
    }
  }

  return {
    footer: '🕸️',
    icon: '🕷️'
  }
}

function makePanel(modo, titulo, corpo, footer) {
  const theme = panelTheme(modo)

  const lines = String(corpo || '').split('\n')

  let out = `╭━━━〔 ${titulo} 〕━━━╮\n│`

  for (const line of lines) {
    if (!line) {
      out += '\n│'
    } else {
      out += `\n│ ${line}`
    }
  }

  out +=
    `\n│\n╰━━━━━━〔 ${footer || theme.footer} 〕━━━━━━╯`

  return out
}

function panelSuccess(modo, titulo, corpo) {
  return makePanel(
    modo,
    `✅ ${titulo}`,
    corpo,
    '🕸️'
  )
}

function panelError(modo, titulo, corpo) {
  return makePanel(
    modo,
    `❌ ${titulo}`,
    corpo,
    '💀'
  )
}

function panelWarning(modo, titulo, corpo) {
  return makePanel(
    modo,
    `⚠️ ${titulo}`,
    corpo,
    '💢'
  )
}

function panelPermission(modo, titulo, corpo) {
  return makePanel(
    modo,
    `🔐 ${titulo}`,
    corpo,
    '🛡️'
  )
}

function panelProcessing(modo, titulo, corpo) {
  return makePanel(
    modo,
    `⚙️ ${titulo}`,
    corpo,
    '🕸️'
  )
}

function panelConfirmation(modo, titulo, corpo) {
  return makePanel(
    modo,
    `⚠️ ${titulo}`,
    corpo,
    '⏳'
  )
}

function progressBar(percent) {
  const total = 10
  const filled = Math.round(
    (percent / 100) * total
  )

  return (
    '█'.repeat(Math.max(0, filled)) +
    '░'.repeat(Math.max(0, total - filled))
  )
}

function createProgress(sock, from, quoted, modo, titulo, corpo) {
  return sock.sendMessage(
    from,
    {
      text: panelProcessing(
        modo,
        titulo,
        `${corpo}\n\n${progressBar(10)} 10%`
      )
    },
    { quoted }
  )
}

async function editProgress(
  sock,
  from,
  key,
  modo,
  titulo,
  corpo,
  percent,
  footer
) {
  if (!key) return null

  return sock.sendMessage(
    from,
    {
      text: makePanel(
        modo,
        `⚙️ ${titulo}`,
        `${corpo}\n\n${progressBar(percent)} ${percent}%`,
        footer || '🕸️'
      ),
      edit: key
    }
  )
}

function setPending(from, executor, action, target) {
  const key =
    `${from}:${normalizeJid(executor)}`

  pending.set(key, {
    action,
    target,
    executor: normalizeJid(executor),
    time: Date.now()
  })

  return key
}

function getPending(from, executor) {
  const key =
    `${from}:${normalizeJid(executor)}`

  const data = pending.get(key)

  if (!data) return null

  if (Date.now() - data.time > 30000) {
    pending.delete(key)
    return null
  }

  return data
}

function clearPending(from, executor) {
  const key =
    `${from}:${normalizeJid(executor)}`

  pending.delete(key)
}

function targetFromMessage(m) {
  return (
    getFirstMention(m) ||
    getQuotedParticipant(m)
  )
}

async function resolveTarget(sock, m, from, args) {
  const mentioned = getFirstMention(m)

  if (mentioned) return mentioned

  const quoted = getQuotedParticipant(m)

  if (quoted) return quoted

  const first = args?.[0]

  if (
    first &&
    /^\d{7,15}$/.test(
      first.replace(/[^\d]/g, '')
    )
  ) {
    return `${first.replace(/[^\d]/g, '')}@s.whatsapp.net`
  }

  return null
}

function removeMentionTokens(args) {
  return (args || []).filter(
    x => !/^@\d+$/.test(x)
  )
}

