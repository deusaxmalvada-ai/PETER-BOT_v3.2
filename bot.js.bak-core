function personaReply(modo, sender) {
  const numero =
    String(sender || '')
      .split('@')[0]
      .split(':')[0]

  if (modo === 'Aranha') {
    return pick(aranhaDB.mention)
      .replace('%s', numero)
  }

  return pick(peterDB.mention)
    .replace('%s', numero)
}

function personaOwner(modo) {
  return modo === 'Aranha'
    ? pick(aranhaDB.dono)
    : pick(peterDB.dono)
}

